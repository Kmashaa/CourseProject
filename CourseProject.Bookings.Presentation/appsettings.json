{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "bookings-service-group"

  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=bookings;Username=postgres;Password=postgres"
  },
